diff --git a/work-atual/verificar-patch.cjs b/verificar-patch.cjs
new file mode 100644
index 0000000..0c4a8f9
--- /dev/null
+++ b/verificar-patch.cjs
@@ -0,0 +1,153 @@
+/* Execute: node verificar-patch.cjs (Node.js 18+; sem dependências). */
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+const path = require('node:path');
+
+const fonte = fs.readFileSync(path.join(__dirname, 'assets/js/nucleo-cuidado.js'), 'utf8');
+function iniciar(salvo) {
+  const banco = new Map(salvo ? [['mutirao-mvp-estado-v1', salvo]] : []);
+  let falhar = false;
+  const documento = { getElementById() { return null; }, querySelector() { return { prepend() {} }; },
+    querySelectorAll() { return []; }, addEventListener() {},
+    createElement() { return { setAttribute() {} }; } };
+  const contexto = { document: documento, Event: class {},
+    window: { addEventListener() {}, dispatchEvent() {} },
+    sessionStorage: { getItem(k) { return banco.get(k) || null; }, setItem(k, v) {
+      if (falhar) throw new Error('QuotaExceededError'); banco.set(k, v);
+    } } };
+  vm.runInNewContext(fonte, contexto);
+  return { core: contexto.window.MutiraoCuidado, banco, falhar: valor => { falhar = valor; } };
+}
+let total = 0;
+function teste(nome, executar) {
+  executar(); total++; console.log(`OK ${nome}`);
+}
+
+teste('falha de persistência mantém memória e versão salva', () => {
+  const app = iniciar();
+  app.core.atualizarEstado({ teste: 1 });
+  const antes = JSON.stringify(app.core.obterEstado());
+  app.falhar(true);
+  assert.throws(() => app.core.atualizarEstado(estado => { estado.person.nome = 'Alterado'; return estado; }), /Não foi possível salvar/);
+  assert.equal(JSON.stringify(app.core.obterEstado()), antes);
+  assert.equal(app.banco.get('mutirao-mvp-estado-v1'), antes);
+});
+
+teste('convite aceito integra rede; recusa não cria participante', () => {
+  const { core } = iniciar();
+  core.atualizarEstado({ convites: [{ email: 'teste@example.com', papel: 'Participante', vinculo: 'Família' }, { email: 'recusa@example.com' }] });
+  core.resolverConvite('teste@example.com', true);
+  core.resolverConvite('recusa@example.com', false);
+  assert(core.obterParticipantesRede().some(p => p.nome === 'teste@example.com'));
+  assert(!core.obterParticipantesRede().some(p => p.nome === 'recusa@example.com'));
+  assert.equal(core.obterEstado().convites.length, 0);
+  assert.throws(() => core.resolverConvite('teste@example.com', true));
+});
+
+teste('aceite atribui cobertura a Bea e persiste; recusa conserva lacuna', () => {
+  const { core, banco } = iniciar();
+  const chave = `${core.HOJE}|12h–13h`;
+  const item = { dia: core.HOJE, horario: '12h–13h', responsavel: 'Beatriz da Silva (Bea)' };
+  core.atualizarEstado({ atribuicoesTurno: { [chave]: item } });
+  core.resolverAtribuicao(chave, true);
+  assert.equal(core.obterLacunasDia(core.HOJE).length, 0);
+  const turno = core.construirLinhaDoTempoDia(core.HOJE).find(s => s.inicio === 12);
+  assert.equal(turno.pessoa.nome, item.responsavel);
+  assert(!core.obterEstado().atribuicoesTurno[chave]);
+  const recarga = iniciar(banco.get('mutirao-mvp-estado-v1')).core;
+  assert.equal(recarga.obterLacunasDia(core.HOJE).length, 0);
+  const outro = iniciar().core;
+  outro.atualizarEstado({ atribuicoesTurno: { [chave]: item } });
+  outro.resolverAtribuicao(chave, false);
+  assert.equal(outro.obterLacunasDia(core.HOJE).length, 1);
+});
+
+teste('cobertura assumida limpa atribuição antiga e não a recupera ao cancelar', () => {
+  const { core } = iniciar();
+  core.atualizarEstado({ atribuicoesTurno: { [`${core.HOJE}|12h–13h`]: { dia: core.HOJE, horario: '12h–13h' } } });
+  core.atualizarEstado(e => core.aplicarIntervaloZe(e, core.HOJE, 12, 13, 12, 13));
+  core.atualizarEstado(e => core.aplicarIntervaloZe(e, core.HOJE, 12, 13, 12, 12));
+  assert.equal(Object.keys(core.obterEstado().atribuicoesTurno).length, 0);
+  assert.equal(core.obterLacunasDia(core.HOJE).length, 1);
+});
+
+teste('folga aceita transfere turno real sem criar lacuna', () => {
+  const { core } = iniciar();
+  core.atualizarEstado({ pedidosFolga: [{ id: 'folga-1', dia: core.HOJE, inicio: 19, fim: 24, status: 'Pendente' }] });
+  core.resolverFolga('folga-1', 'Aceita', 'Paulo da Silva (Paul)');
+  const turno = core.construirLinhaDoTempoDia(core.HOJE).find(s => s.inicio === 19);
+  assert.equal(turno.pessoa.nome, 'Paulo da Silva (Paul)');
+  assert.equal(core.obterEstado().pedidosFolga[0].status, 'Aceita');
+  assert.equal(core.obterLacunasDia(core.HOJE).length, 1); // somente a lacuna original das 12h
+  assert.throws(() => core.resolverFolga('folga-1', 'Aceita', 'Ana da Silva (Aninha)'));
+});
+
+teste('estoque zero exige origem; origem externa não consome saldo; desfazer preserva saldo', () => {
+  const { core } = iniciar();
+  core.atualizarEstado({ itensExtras: [{ chave: 'item-teste', nome: 'Medicamento teste', dose: '1 unidade', horarios: '12h', tipo: 'Medicamento' }], estoqueBase: { 'item-teste': 0 } });
+  const dose = core.obterDoses().find(d => d.itemId === 'item-teste');
+  assert.equal(dose.nome, 'Medicamento teste');
+  assert.throws(() => core.registrarDose(dose.chave, { estado: 'administrado', horario: '12:30' }), /origem externa/);
+  core.registrarDose(dose.chave, { estado: 'administrado', horario: '12:30', origemExterna: 'Unidade trazida pela família' });
+  assert.equal(core.obterEstoque('item-teste'), 0);
+  assert.equal(core.obterDoses().find(d => d.chave === dose.chave).origemExterna, 'Unidade trazida pela família');
+  core.desfazerDose(dose.chave);
+  assert.equal(core.obterEstoque('item-teste'), 0);
+  assert(core.obterResumoMedicamentos().some(texto => texto.includes('Medicamento teste')));
+});
+
+teste('administração consome uma unidade e reversão restaura saldo', () => {
+  const { core } = iniciar();
+  const dose = core.obterDoses().find(d => d.itemId === 'Metformina' && d.estado === 'prevista');
+  const saldo = core.obterEstoque('Metformina');
+  core.registrarDose(dose.chave, { estado: 'administrado', horario: '12:30' });
+  assert.equal(core.obterEstoque('Metformina'), saldo - 1);
+  core.desfazerDose(dose.chave);
+  assert.equal(core.obterEstoque('Metformina'), saldo);
+});
+
+teste('lembretes respeitam opções e não duplicam após recarga', () => {
+  const { core, banco } = iniciar();
+  const novos = core.executarLembretes('2026-11-15T23:00', { antecedenciaMedicacao: '30' });
+  assert(novos.some(item => item.id.startsWith('dose-')));
+  assert(novos.some(item => item.id.startsWith('apoio-')));
+  const recarga = iniciar(banco.get('mutirao-mvp-estado-v1')).core;
+  assert.equal(recarga.executarLembretes('2026-11-15T23:00').length, 0);
+  assert.throws(() => recarga.executarLembretes('2026-11-10T12:00'), /avançar/);
+  const sem = iniciar().core;
+  sem.atualizarEstado({ cuidar: { preferencias: { pausa: false, apoio: false, agradecer: false } } });
+  assert.equal(sem.executarLembretes('2026-11-15T23:00', { notificacoesMedicacao: false }).length, 0);
+});
+
+teste('saída transfere administração e turnos futuros', () => {
+  const { core } = iniciar();
+  core.sairDaRede('Ana da Silva (Aninha)');
+  assert.equal(core.obterEstado().redeSaiu, true);
+  assert.equal(core.obterEstado().administradorRede, 'Ana da Silva (Aninha)');
+  assert(!core.construirLinhaDoTempoDia(core.HOJE).some(s => s.pessoa?.ehUsuarioAtual));
+  assert.equal(core.obterEstado().perfilUsuario.papel, 'Participante');
+});
+
+teste('catálogo resolve nome e dose do medicamento novo por ID', () => {
+  const { core } = iniciar();
+  core.atualizarEstado({ itensExtras: [{ chave: 'item-novo', nome: 'Cadastro preservado', dose: '1 unidade', tipo: 'Medicamento', horarios: '8h' }] });
+  const codigo = fs.readFileSync(path.join(__dirname, 'assets/js/medicamentos.js'), 'utf8');
+  const trecho = codigo.slice(codigo.indexOf('  const obterItens ='), codigo.indexOf('  const descreverItem ='));
+  const itens = vm.runInNewContext(`${trecho}; obterItens()`, { obterEstado: core.obterEstado, obterDoses: core.obterDoses,
+    obterEstoque: core.obterEstoque, INSUMOS: [], juntarHorarios: lista => lista.join(', ') });
+  const item = itens.find(i => i.chave === 'item-novo');
+  assert.equal(item.nome, 'Cadastro preservado');
+  assert.equal(item.dose, '1 unidade');
+});
+
+teste('exportação soma duração cruzando dia, mês e ano', () => {
+  const codigo = fs.readFileSync(path.join(__dirname, 'assets/js/agenda.js'), 'utf8');
+  const trecho = codigo.slice(codigo.indexOf('      const calcularFim ='), codigo.indexOf('      const linhas = eventosMes.flatMap'));
+  const calcularFim = vm.runInNewContext(`${trecho}; calcularFim`);
+  assert.equal(calcularFim('2026-11-10', '23:30'), '20261111T003000');
+  assert.equal(calcularFim('2026-11-30', '23:00'), '20261201T000000');
+  assert.equal(calcularFim('2026-12-31', '23:30'), '20270101T003000');
+});
+
+console.log(`${total} cenários de regressão aprovados. Não substituem validação visual e por teclado no navegador.`);
